{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scout",
  "identifier": "dev.scoutcode.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm --prefix ui run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://w.soundcloud.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://*.ytimg.com https://*.ggpht.com https://*.sndcdn.com",
        "media-src": "'self' blob: data: music: http://music.localhost",
        "font-src": "'self' data:",
        "frame-src": "https://w.soundcloud.com",
        "connect-src": "ipc: http://ipc.localhost music: http://music.localhost"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "ScoutCode",
    "shortDescription": "Scout",
    "icon": ["assets/icon.ico", "assets/icon.png"]
  }
}
