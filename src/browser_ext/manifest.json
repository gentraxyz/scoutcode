{
  "manifest_version": 3,
  "name": "Scout",
  "version": "1.6.0",
  "description": "Adds Scout to claude.ai or Gemini as a connector, step by step, when you start it from the Scout app.",
  "permissions": ["debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*", "https://gemini.google.com/*", "https://scoutcode.dev/oauth/authorize*", "https://scoutcode.dev/login*"], "js": ["claude.js"], "run_at": "document_idle" }
  ]
}
