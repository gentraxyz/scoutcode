{
  "manifest_version": 3,
  "name": "Scout for DeepSeek",
  "version": "1.0.0",
  "description": "Lets the Scout desktop app use your chat.deepseek.com account as its model, with Scout's tools and MCP servers.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://chat.deepseek.com/*"], "js": ["driver.js", "main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://chat.deepseek.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Scout for DeepSeek" }
}
